# Checks if a given choice is a valid number within a given range.
check_choice() {
    local choice="$1"
    local max="$2"
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$max" ]; then
        return 0
    else
        return 1
    fi
}

