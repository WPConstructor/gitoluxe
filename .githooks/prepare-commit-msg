# Cleans up AI-generated messages by removing newlines, tabs, backticks, and extra spaces.
cleanup_ai_msg() {
    echo "$1" | tr -d '\n\t' | sed -E 's/[[:space:]]+/ /g; s/`//g' | cut -c1-150
}

# Generates the commit message subject using Ollama.
generate_subject() {
    printf "%s" "$diff_payload" | ollama run qwen2.5-coder:7b "$SUBJECT_PROMPT"
}

# Generates a batch of commit message suggestions and sorts them longest first.
generate_batch() {
    local start=$1
    local end=$2
    local idx=$start
    local messages=()

    print_title
    echo ""

    print_center "Generating commit subject message suggestions..."

    while [ "$idx" -le "$end" ]; do
        msg=$(generate_subject)
        msg=$(cleanup_ai_msg "$msg")
        if [ -n "$msg" ]; then
            messages+=("$msg")
        fi

        idx=$((idx + 1))
    done

    # Sort messages by length: shortest first, longest last
    readarray -t messages < <(
        printf "%s\n" "${messages[@]}" |
        awk '{ print length($0) "\t" $0 }' |
        sort -n |
        cut -f2-
    )

    # Assign sorted messages back to AI_MSG variables
    idx=$start
    for msg in "${messages[@]}"; do
        printf -v "AI_MSG_$idx" '%s' "$msg"
        idx=$((idx + 1))
    done
}

# Add AI-generated commit message suggestions batch
add_message_suggestions(){
    start_t=$SECONDS
    total_ai_msg=$((total_ai_msg + 5))
    [ "$total_ai_msg" -gt $MAX_AI_MSGS ] && total_ai_msg=MAX_AI_MSGS
    start_idx=$((total_ai_msg - MSGS_ADD -1))
    [ "$start_idx" -lt 1 ] && start_idx=1

    generate_batch "$start_idx" "$total_ai_msg"

    # Extract scopes from generated commit messages and collect unique scopes
    for i in $(seq "$start_idx" "$total_ai_msg"); do
        var_name="AI_MSG_$i"
        msg="${!var_name}"
        if [ -n "$msg" ]; then
            readarray -t parsed_parts < <(parse_commit_message "$msg")
            current_scope="${parsed_parts[1]}"

            if [ -n "$current_scope" ] && [ -z "${scope_map[$current_scope]}" ]; then
                unique_scopes+=("$current_scope")
                scope_map[$current_scope]=1
            fi
        fi
    done

    gen_time_info="$((SECONDS - start_t))s"
    regen_ai=0
}

# ----------------------------
# Display Functions (Step 1)
# ----------------------------

print_messages(){
    local idx display_count msg var_name next_found tmp j
    declare -A printed_msgs

    idx=1
    display_count=0

    while [ "$idx" -le "$MAX_AI_MSGS" ]; do
        var_name="AI_MSG_$idx"
        msg="${!var_name}"

        if [ -n "$msg" ]; then

            # Skip duplicate AI messages
            if [ -n "${printed_msgs[$msg]}" ]; then
                idx=$((idx + 1))
                continue
            fi
            printed_msgs[$msg]=1

            # group spacing (before group except first)
            if [ $((display_count % MSGS_ADD)) -eq 0 ] && [ "$display_count" -ne 0 ]; then
                print_tty ""
            fi

            print_tty_indent_5 " [$idx] $msg"

            display_count=$((display_count + 1))

            # check if another unique message exists AFTER this one
            next_found=0
            j=$((idx + 1))

            while [ "$j" -le "$MAX_AI_MSGS" ]; do
                tmp="AI_MSG_$j"

                if [ -n "${!tmp}" ] && [ -z "${printed_msgs[${!tmp}]}" ]; then
                    next_found=1
                    break
                fi

                j=$((j + 1))
            done

            if [ "$next_found" -eq 1 ]; then
                print_tty ""
            fi
        fi

        idx=$((idx + 1))
    done
}

