#!/bin/bash

COMMIT_MSG_FILE=$1
SOURCE=$2

# Skip merge commits
if [ "$SOURCE" = "merge" ]; then
  exit 0
fi

DIFF=$(git diff --cached)

if [ -z "$DIFF" ]; then
  exit 0
fi

echo ""
echo "🤖 Git AI Assistant"
echo "--------------------"
echo "Generating suggestion..."

AI_MSG=$(echo "$DIFF" | ollama run qwen3.5:7b "
You are a senior software engineer.
Generate a concise conventional commit message ONLY.
No explanation.
")

echo ""
echo "=============================="
echo "🧠 AI Suggested Commit:"
echo "=============================="
echo "$AI_MSG"
echo "=============================="
echo ""

echo "Options:"
echo "1) Accept AI message"
echo "2) Edit AI message"
echo "3) Write your own message"
echo ""

read -p "Select (1/2/3): " choice

case "$choice" in

  1)
    echo "$AI_MSG" > "$COMMIT_MSG_FILE"
    echo "✅ AI commit accepted"
    ;;

  2)
    echo "✍️ Editing AI message..."
    echo "$AI_MSG" > "$COMMIT_MSG_FILE"
    ${EDITOR:-nano} "$COMMIT_MSG_FILE"
    ;;

  3)
    echo "✍️ Write your own message..."
    echo "" > "$COMMIT_MSG_FILE"
    ${EDITOR:-nano} "$COMMIT_MSG_FILE"
    ;;

  *)
    echo "Invalid choice - aborting commit"
    exit 1
    ;;
esac