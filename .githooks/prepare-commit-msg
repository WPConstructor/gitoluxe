#!/bin/bash

set -e

COMMIT_MSG_FILE="$1"
SOURCE="$2"

case "$SOURCE" in
    merge|squash)
        exit 0
        ;;
esac

if [ -s "$COMMIT_MSG_FILE" ]; then
    exit 0
fi

if [ ! -e /dev/tty ]; then
    exit 0
fi

DIFF=$(git diff --cached)

[ -z "$DIFF" ] && exit 0

echo > /dev/tty
echo "🤖 Git AI Assistant" > /dev/tty
echo "--------------------" > /dev/tty
echo "Generating suggestion..." > /dev/tty

if ! ollama --version >/dev/null 2>&1; then
    echo "⚠️ Ollama not found." > /dev/tty
    exit 0
fi

# ----------------------------
# ⏱ START TIMER
# ----------------------------
start_ns=$(date +%s%N)

DIFF_B64=$(git diff --cached | base64 | tr -d '\n')

DIFF=$(git diff --cached --unified=1 | head -c 6000)    

AI_MSG=$(printf "%s" "$DIFF" | ollama run qwen2.5-coder:7b "
You are a senior software engineer and Git expert.

Analyze the git diff and determine the PRIMARY purpose of the change.

IMPORTANT:

Step 1 (internal):
Determine whether the diff introduces ANY new user-visible functionality.

User-visible functionality includes:
- new menu options
- new commands
- new CLI flags
- new prompts
- new configuration options
- new user interactions
- new features or capabilities

If the answer is YES:
- The commit type MUST be feat
- Ignore accompanying refactoring

If the answer is NO:
- Choose the most appropriate type:
  - fix = bug correction
  - refactor = code restructuring without new functionality
  - chore = maintenance, cleanup, tooling
  - docs = documentation changes
  - test = test changes
  - perf = performance improvements
  - build = build system changes
  - ci = CI/CD changes

Step 2 (internal):
Determine the most appropriate scope from:
- githooks
- ai
- ollama
- commit
- cli
- installer

If no scope is obvious, omit it.

Step 3:
Generate EXACTLY ONE Conventional Commit message.

FORMAT:
type(scope): description

RULES:
- Output ONLY the commit message
- No markdown
- No code fences
- No explanations
- No bullet points
- No JSON
- No period at the end
- Maximum 72 characters
- Use imperative mood
- Prefer feat over refactor when both are present
- Describe the user-facing outcome, not the implementation details

GOOD EXAMPLES:
feat(githooks): add staged diff preview before commit
feat(cli): add interactive commit selection
fix(ai): handle empty diff generation
chore(installer): update Ollama installation logic
refactor(commit): simplify message generation flow
")

# ----------------------------
# ⏱ END TIMER
# ----------------------------
end_ns=$(date +%s%N)

# time in seconds
duration_ms=$(( (end_ns - start_ns) / 1000000 ))

# ----------------------------
# 🧠 TOKEN ESTIMATE
# ----------------------------
chars=$(printf "%s" "$DIFF_B64" | wc -c)
tokens=$((chars / 4))   # rough estimate: 1 token ≈ 4 chars

if [ "$duration_ms" -gt 0 ]; then
    tps=$(awk "BEGIN {printf \"%.2f\", $tokens / ($duration_ms / 1000)}")
else
    tps="∞"
fi

if [ -z "$AI_MSG" ]; then
    echo "⚠️ Failed to generate commit message." > /dev/tty
    exit 0
fi

# ----------------------------
# 📊 TPS OUTPUT
# ----------------------------
echo "⚡ Tokens/sec: $tps" > /dev/tty
echo "⏱ Time: ${duration_ms}ms" > /dev/tty
echo "🧮 Tokens (est): $tokens" > /dev/tty

echo > /dev/tty

prompt_choice() {
    local answer

    while true; do
        printf "[A]ccept, [E]dit, [M]anual, [S]how Changes ? " > /dev/tty

        if ! IFS= read -r answer < /dev/tty; then
            echo "a"
            return
        fi

        answer=$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')

        case "$answer" in
            a|e|m|s|"")
                echo "${answer:-a}"
                return
                ;;
        esac

        echo "Please choose A, E, M or S." > /dev/tty
    done
}

while true; do
    echo > /dev/tty
    echo "==============================" > /dev/tty
    echo "🧠 AI Suggested Commit:" > /dev/tty
    echo "==============================" > /dev/tty
    echo "$AI_MSG" > /dev/tty
    echo "==============================" > /dev/tty

    choice=$(prompt_choice)

    case "$choice" in

        a)
            printf "%s\n" "$AI_MSG" > "$COMMIT_MSG_FILE"
            echo "✅ AI commit accepted" > /dev/tty
            break
            ;;

        e)
            printf "%s\n" "$AI_MSG" > "$COMMIT_MSG_FILE"
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
            break
            ;;

        m)
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
            break
            ;;

        s)
            git diff --cached
            ;;
    esac
done

exit 0