# Displays the ASCII art title with color.
print_title() {
    local color="$VIOLET"
    local version_color="$WHITE"
    local width line trimmed pad current_color

    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    while IFS= read -r line; do
        # skip empty lines
        [ -z "$line" ] && continue

        # truncate line to terminal width
        trimmed="${line:0:width}"

        # compute padding for centering
        pad=$(( (width - ${#trimmed}) / 2 ))
        [ "$pad" -lt 0 ] && pad=0

        # Use white for version line
        if [[ "$line" == v1.* ]]; then
            current_color="$version_color"
        else
            current_color="$color"
        fi

        # print centered line with color
        printf "%*s%b%s%b\n" \
            "$pad" "" \
            "$current_color" \
            "$trimmed" \
            "\033[0m" > /dev/tty

    done << 'EOF'
  ________.__  __         .__                       
 /  _____/|__|/  |_  ____ |  |  __ _____  ___ ____  
/   \  ___|  \   __\/  _ \|  | |  |  \  \/  // __ \ 
\    \_\  \  ||  | (  <_> )  |_|  |  />    <\  ___/ 
 \______  /__||__|  \____/|____/____//__/\_ \\___  >
        \/                                 \/    \/ 
v1.0.0 (c) 2026 by WPConstructor - MIT License
EOF
}

# prints a colored text in the middle of the window
print_center() {
    local text="$1"
    local color="$2"
    local width cols padding

    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    cols=${#text}

    padding=$(( (width - cols) / 2 ))
    [ "$padding" -lt 0 ] && padding=0

    printf "%*s%b%s%b\n" \
        "$padding" "" "$color" "$text" "\033[0m" > /dev/tty
}

# Prints a colored multi-line text centered as one block with word wrapping.
print_multi_line_center() {
    local text="$1"
    local color="$2"
    local max_width="$3"
    local width longest=0 padding line wrapped

    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    # Use provided max width or calculate from terminal width
    if [ -z "$max_width" ]; then
        max_width=$((width - 4))
    fi

    # Limit max width to terminal width
    if [ "$max_width" -gt "$width" ]; then
        max_width=$((width - 4))
    fi

    [ "$max_width" -lt 1 ] && max_width=1

    # Wrap long lines
    wrapped=$(printf '%s' "$text" | fold -s -w "$max_width")

    # Find longest wrapped line
    while IFS= read -r line; do
        [ ${#line} -gt "$longest" ] && longest=${#line}
    done <<< "$wrapped"

    # Calculate left padding for centering
    padding=$(( (width - longest) / 2 ))
    [ "$padding" -lt 0 ] && padding=0

    # Print all wrapped lines centered with color
    while IFS= read -r line; do
        printf "%*s%b%s%b\n" \
            "$padding" "" \
            "$color" \
            "$line" \
            "\033[0m" > /dev/tty
    done <<< "$wrapped"
}

# Prints a message to the TTY, wrapped to the terminal width.
print_tty() {
    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)
    echo -e "$@" | fold -s -w "$width" > /dev/tty
}

# Prints a message to the TTY, wrapped and with a 1-space indent on subsequent lines.
print_tty_indent_1() {
    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    printf "%s\n" "$@" \
        | fold -s -w "$width" \
        | sed '2,$s/^/ /' \
        > /dev/tty
}

# Prints a message to the TTY, wrapped and with a 5-space indent on subsequent lines.
print_tty_indent_5() {
    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    printf "%s\n" "$@" \
        | fold -s -w "$width" \
        | sed '2,$s/^/     /' \
        > /dev/tty
}

# Displays a colored horizontal line separator spanning the terminal width.
print_seperator() {
    local color="$VIOLET"
    local width char inner line

    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)
    char="-"

    # leave 1 space left + 1 space right
    inner=$((width - 2))
    [ "$inner" -lt 1 ] && inner=1

    printf -v line '%*s' "$inner" ''
    line=${line// /$char}

    printf "%b %s %b\n" "$color" "$line" "\033[0m" > /dev/tty
}

