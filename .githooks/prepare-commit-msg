            fi
            ;;

        a)
            new_msg="🧠 Adding 5 AI commit suggestions..."
            regen_ai=1
            continue
            ;;
        t)
            types=("feat" "fix" "refactor" "style" "docs" "test" "perf" "chore" "release" "remove" "build" "ci" "security" "i18n" "deps" "hotfix" "ui" "merge" "revert" "move" "cleanup")
            new_type=""
            new_type_msg=""

            while true; do
                clear
                print_seperator
                print_tty "Select Prefix Type (Stored: ${selected_type:-None}):"
                for i in "${!types[@]}"; do
