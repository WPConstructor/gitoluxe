# Print a centered, responsive multi-column menu in the terminal
print_menu() {
    local width cols i j item len pad line cell

    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    cols=$(( width / 20 ))
    [ "$cols" -lt 1 ] && cols=1

    declare -a col_max

    for ((i=0; i<cols; i++)); do
        col_max[i]=0
    done

    # Calculate widths without ANSI codes
    for i in "${!menu_items[@]}"; do
        col=$(( i % cols ))
        len=${#menu_items[i]}
        [ "$len" -gt "${col_max[col]}" ] && col_max[col]=$len
    done

    local row_width=0
    for ((i=0; i<cols; i++)); do
        row_width=$(( row_width + col_max[i] + 2 ))
    done

    pad=$(( (width - row_width) / 2 + 1 ))
    [ "$pad" -lt 0 ] && pad=0

    i=0
    while [ $i -lt ${#menu_items[@]} ]; do
        line=""

        for ((j=0; j<cols; j++)); do
            if [ $((i + j)) -lt ${#menu_items[@]} ]; then
                item="${menu_items[i+j]}"

                # Color only the shortcut letter inside brackets
                item=$(printf '%s' "$item" | sed \
                    "s/\[\([^]]\)\]/[${BG_RED}\1${RESET}]/")

                printf -v cell "%-*s" "${col_max[j]}" "$item"
            else
                printf -v cell "%-*s" "${col_max[j]}" ""
            fi

            line+="$cell  "
        done

        printf "%*s%s\n" "$pad" "" "$line" > /dev/tty

        i=$((i + cols))
    done
}

