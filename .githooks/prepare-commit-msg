#!/bin/bash

set -e

REQUIRED_GB=6
MAX_CHARS=7000
COMMIT_MSG_FILE="$1"
SOURCE="$2"

# ----------------------------
# 🛠️ Utilities
# ----------------------------

print_tty() {
    echo -e "$@" > /dev/tty
}

# ----------------------------
# ⚙️ System Checks
# ----------------------------

check_resources() {
    local free_ram_gb=$(free -g | awk '/^Mem:/ {print $7}')
    local free_vram_gb=0
    
    if command -v nvidia-smi >/dev/null 2>&1; then
        free_vram_gb=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | awk '{sum+=$1} END {print sum/1024}')
    fi
    free_vram_gb=${free_vram_gb:-0}

    local ollama_used_gb=$(ollama ps 2>/dev/null | awk '
        NR > 1 {
            size=$3; unit=$4
            if (unit == "GB") sum += size
            else if (unit == "MB") sum += size / 1024
        }
        END { printf "%.2f", sum + 0 }
    ')
    ollama_used_gb=${ollama_used_gb:-0}

    local total_mem_gb=$(awk "BEGIN {print $free_ram_gb + $free_vram_gb + $ollama_used_gb}")

    if (( $(echo "$total_mem_gb < $REQUIRED_GB" | bc -l) )); then
        print_tty "⚠️ Warning: Low memory detected (${total_mem_gb} GB available). Qwen 2.5 7B may run poorly."
        read -r -p "Continue anyway? (Y/N): " choice < /dev/tty > /dev/tty

        case "$choice" in
            [Yy]*) print_tty "Continuing..." ;;
            [Nn]*)
                print_tty "Exiting..."
                exit 1
                ;;
            *)
                print_tty "Invalid choice. Exiting..."
                exit 1
                ;;
        esac
    fi
}

check_resources

# ----------------------------
# 🚫 Skip unsafe contexts
# ----------------------------
case "$SOURCE" in
    merge|squash)
        exit 0
        ;;
esac

existing_msg=$(cat "$COMMIT_MSG_FILE" 2>/dev/null)

case "$existing_msg" in
    ""|ai)
        ;;
    *)
        # Allow amend commits to proceed even if the file isn't empty
        if [ "$SOURCE" != "commit" ]; then
            exit 0
        fi
        ;;
esac

if [ ! -e /dev/tty ]; then
    exit 0
fi

# ----------------------------
# 📦 Collect staged data
# ----------------------------

staged_files=$(git diff --cached --name-status)
staged_stat=$(git diff --cached --stat)
staged_diff=$(git diff --cached --unified=1 --no-color | head -c "$MAX_CHARS")

# If nothing staged, check commit context (amend / override)
if [ -z "$staged_files" ]; then
    if [ "$SOURCE" = "commit" ] || [ "$SOURCE" = "message" ]; then
        staged_files=$(git show --name-status --format="" HEAD 2>/dev/null | head -c "$MAX_CHARS")
        staged_stat=$(git show --stat --format="" HEAD 2>/dev/null | head -c "$MAX_CHARS")
        staged_diff=$(git diff HEAD --unified=1 --no-color 2>/dev/null | head -c "$MAX_CHARS")

        if [ -z "$staged_diff" ]; then
            staged_diff=$(git show --unified=1 --no-color HEAD 2>/dev/null | head -c "$MAX_CHARS")
        fi
    fi
fi

diff_len=${#staged_diff}
[ "$diff_len" -eq "$MAX_CHARS" ] && staged_diff="${staged_diff}\n\n... (truncated)"

# ----------------------------
# 🧠 AI Prompts & Data
# ----------------------------

diff_payload=$(printf "
STAGED FILES (IMPORTANT):
%s

STAGED STAT:
%s

SUMMARIZED DIFF:
%s
" "$staged_files" "$staged_stat" "$staged_diff" | sed -E '
    s|^([+-])[[:space:]]*#|\1 COMMENT:|;
    s|^([+-])[[:space:]]*//|\1 COMMENT:|;
    s|^([+-])[[:space:]]*/\*|\1 COMMENT:|;
')

SUBJECT_PROMPT="Generate exactly one Conventional Commit message.

Rules:
- Output one line only, no markdown, explanations, quotes, code fences, or extra text.
- Format: type(scope): description
- Max 120 chars.
- Use imperative mood.
- Describe the primary changes, not the implementation details.

Type selection:
- feat: new user-visible/runtime behavior or capability.
- fix: bug fix.
- refactor: code restructuring without behavior change.
- docs: documentation/Markdown-only changes.
- test: tests only.
- perf: performance improvement.
- build: build/dependency changes.
- ci: CI/CD changes.
- chore: maintenance/tooling/cleanup.

Important:
- Markdown files are documentation unless accompanying a code change.
- Comments provide intent and context but do not make a change a feat.
- New functions, renames, moves, cleanup, comments, labels, docs, and formatting are not features by themselves.
- If unsure between feat and refactor, choose refactor.
- If any new user-visible functionality exists, choose feat.

Scope (if obvious):
githooks, ai, ollama, commit, cli, installer

Return only the commit message."

BODY_PROMPT="Generate only the Git commit body.

Rules:
- Plain text only.
- No subject line.
- No commit type.
- No markdown, bullets, JSON, code blocks, emojis, or explanations.
- Output only the body.

Interpretation:
- .md files are documentation, not source code.
- Describe documentation changes as documentation changes.
- Comments provide context but do not imply behavior changes.
- Do not infer features from comments, labels, annotations, formatting, or documentation.
- Behavior changes come only from executable code changes.

Format:
- First line: concise summary of what changed and why.
- Up to 4 additional lines with important details.
- Focus on behavior, user impact, and key changes.
- Ignore minor refactors unless they affect behavior.

Example:

Adds interactive commit selection to improve workflow

Allows reviewing AI-generated commit messages before use.
Supports regenerating or editing suggestions."

# ----------------------------
# 🧠 AI generator functions
# ----------------------------

generate_body() {
    printf "%s" "$diff_payload" | ollama run qwen2.5-coder:7b "$BODY_PROMPT"
}

generate_subject() {
    printf "%s" "$diff_payload" | ollama run qwen2.5-coder:7b "$SUBJECT_PROMPT"
}

build_commit_message() {
    local subject="$1"
    local body_msg="$2"

    if [ -z "$body_msg" ]; then
        printf "%s\n" "$subject"
    else
        printf "%s\n\n%s\n" "$subject" "$body_msg"
    fi
}

cleanup_ai_msg() {
    echo "$1" | sed -E 's/[[:space:]]+/ /g; s/`//g' | tr -d '\n\t' | cut -c1-150
}

check_choice() {
    local choice="$1"
    local max="$2"
    [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$max" ]
}

generate_batch() {
    local start=$1
    local end=$2
    local idx=$start
    while [ "$idx" -le "$end" ]; do
        msg=$(generate_subject)
        msg=$(cleanup_ai_msg "$msg")
        printf -v "AI_MSG_$idx" '%s' "$msg"
        idx=$((idx + 1))
    done
}

print_separator() {
    local width
    width=$(tput cols 2>/dev/null || echo 80)
    printf '%*s\n' "$width" '' | tr ' ' '='
}

regen_ai=1
total_ai_msg=0
gen_time_info=""
selected_type=""
body_time_info=""
body_msg=""

# ----------------------------
# 🎛 UI loop
# ----------------------------
while true; do
    # ----------------------------
    # 🤖 Add 5 AI Message Suggestions
    # ----------------------------
    if [ "$regen_ai" = "1" ]; then
        start_t=$SECONDS
        total_ai_msg=$((total_ai_msg + 5))
        [ "$total_ai_msg" -gt 20 ] && total_ai_msg=20
        start_idx=$((total_ai_msg - 4))
        [ "$start_idx" -lt 1 ] && start_idx=1

        generate_batch "$start_idx" "$total_ai_msg"
        gen_time_info=" (took $((SECONDS - start_t))s)"
        regen_ai=0
    fi

    # ----------------------------
    # 🤖 Generate AI body message
    # ----------------------------
    if [ "$regen_ai" = "2" ]; then
        start_t=$SECONDS
        body_msg=$(generate_body)
        body_msg="$(
        echo "$body_msg" \
        | sed 's/```.*//g' \
        | sed 's/`//g' \
        | sed 's/\*\*//g' \
        | sed '/^[[:space:]]*$/d'
        )"
        body_time_info=" (took $((SECONDS - start_t))s)"
        regen_ai=0
    fi

    # ----------------------------
    # 🧠 Show suggestions
    # ----------------------------
    print_separator
    print_tty "🧠 AI Suggested Commits$gen_time_info ($diff_len chars):"
    print_separator

    idx=1
    display_count=0
    while [ "$idx" -le 20 ]; do
        var_name="AI_MSG_$idx"  
        msg="${!var_name}"

        if [ -n "$msg" ]; then
            print_tty "[$idx] $msg"
            display_count=$((display_count + 1))
            if [ $((display_count % 5)) -eq 0 ]; then
                print_tty ""
            fi
        fi
        idx=$((idx + 1))
    done

    if [ -z "$body_msg" ]; then
        print_tty "No body"
        remove_body=""
    else
        print_tty "$body_msg$body_time_info"
        remove_body=", [R]emove Body"
    fi
    
    # ----------------------------
    # 🎮 Menu
    # ----------------------------
    print_separator
    printf "Accept [1-%s], [A]dd 5 Suggestions, Set Prefix [T]ype, Set Prefix [S]cope, [Create/Recreate [B]ody%s, Show [C]hanges, Edit [E1-E%s], [M]anual ? " \
        "$total_ai_msg" "$remove_body" "$total_ai_msg" > /dev/tty


    if ! IFS= read -r choice < /dev/tty; then
        choice="1"
    fi
    choice=$(printf '%s' "$choice" | tr '[:upper:]' '[:lower:]')

    case "$choice" in
        [0-9]*)
            if check_choice "$choice" $total_ai_msg; then
                var_name="AI_MSG_$choice"
                final_msg=$(build_commit_message "${!var_name}" "$body_msg")
                printf "%s" "$final_msg" > "$COMMIT_MSG_FILE"
                print_tty "✅ AI commit #$choice accepted"
                exit 0
            else
                print_tty "❌ Please choose 1-$total_ai_msg"
            fi
            ;;
        e[0-9]*)
            idx="${choice#e}"
            if check_choice "$idx" $total_ai_msg; then
                var_name="AI_MSG_$idx"
                final_msg=$(build_commit_message "${!var_name}" "$body_msg")
                printf "%s" "$final_msg" > "$COMMIT_MSG_FILE"
                exec < /dev/tty
                exec > /dev/tty
                exec 2> /dev/tty
                "${EDITOR:-nano}" "$COMMIT_MSG_FILE"
                exit 0
            else
                print_tty "❌ Please choose 1-$total_ai_msg"
            fi
            ;;
        m)
            exec < /dev/tty
            exec > /dev/tty
            exec 2> /dev/tty            
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE"
            exit 0
            ;;

        c)
            if git diff --cached | grep -q .; then
                git diff --cached
            elif git diff HEAD | grep -q .; then
                git diff HEAD
            else
                git show --unified=1 --no-color HEAD
            fi
            ;;

        a)
            print_tty "🧠 Adding 5 AI commit suggestions..."
            regen_ai=1
            continue
            ;;
        t)
            # Extract unique prefix types from existing AI messages
            unique_types=$(for i in $(seq 1 "$total_ai_msg"); do
                var_name="AI_MSG_$i"
                msg="${!var_name}"
                [ -n "$msg" ] && echo "$msg" | sed -E 's/^([^(: ]+).*/\1/'
            done | sort -u)

            if [ -z "$unique_types" ]; then
                print_tty "❌ No suggestions available to extract types from."
                continue
            fi

            print_separator
            print_tty "Select Prefix Type (Stored: ${selected_type:-None}):"
            
            type_list=()
            while IFS= read -r line; do
                [ -n "$line" ] && type_list+=("$line")
            done <<< "$unique_types"

            for i in "${!type_list[@]}"; do
                print_tty "[$((i+1))] ${type_list[$i]}"
            done
            print_tty "[M]anual Input"
            print_separator

            printf "Choice: " > /dev/tty
            read -r type_choice < /dev/tty
            type_choice=$(echo "$type_choice" | tr '[:upper:]' '[:lower:]')

            new_type=""
            if [[ "$type_choice" =~ ^[0-9]+$ ]] && [ "$type_choice" -ge 1 ] && [ "$type_choice" -le "${#type_list[@]}" ]; then
                new_type="${type_list[$((type_choice-1))]}"
            elif [ "$type_choice" = "m" ]; then
                printf "Enter manual prefix type: " > /dev/tty
                read -r new_type < /dev/tty
                new_type=$(echo "$new_type" | tr -d '[:space:]')
            fi

            if [ -n "$new_type" ]; then
                selected_type="$new_type"
                for i in $(seq 1 "$total_ai_msg"); do
                    var_name="AI_MSG_$i"
                    msg="${!var_name}"
                    if [ -n "$msg" ]; then
                        updated_msg=$(echo "$msg" | sed -E "s/^[^(: ]+/$selected_type/")
                        printf -v "AI_MSG_$i" '%s' "$updated_msg"
                    fi
                done
                print_tty "✅ All suggestions updated to type: $selected_type"
            fi
            continue
            ;;
        b)
            print_tty "🧠 Creating body..."
            regen_ai=2
            continue
            ;;
        r)
            body_msg=""
            continue
            ;;

        *)
            print_tty "❌ Please choose 1-$total_ai_msg, A, T, S, B/R, C, E1-E$total_ai_msg, M."
            ;;
    esac

done

exit 0;
