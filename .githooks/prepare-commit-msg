json_escape() {
    jq -Rn --arg str "$1" '$str'
}

# Cleans up AI-generated messages by removing newlines, tabs, backticks, and extra spaces.
cleanup_ai_msg() {
    printf "%s" "$1" \
    | strip_ansi \
    | sed -E 's/\x1B\[[0-9;]*[mKHFJ]//g' \
    | tr -d '\n\t' \
    | sed -E 's/[[:space:]]+/ /g; s/`//g' \
    | cut -c1-150
}

# Generates the commit message subject using Ollama.
generate_subject() {
    clean_diff_payload=$(printf '%s' "$diff_payload" \
    | sed $'s/\x1B\\[[0-9;?]*[ -\\/]*[@-~]//g' \
    | tr -d '\000-\010\013\014\016-\037')
    curl -s http://localhost:11434/api/generate \
        -H "Content-Type: application/json" \
        -d "$(jq -n \
            --arg model "qwen2.5-coder:7b" \
            --arg prompt "$SUBJECT_PROMPT

        DIFF:
        $clean_diff_payload" \
            '{
            model: $model,
            prompt: $prompt,
            options: {
                temperature: 0
            },
            format: {
                type: "object",
                properties: {
                    type: {
                        type: "string"
                    },
                    scope: {
                        type: "string"
                    },
                    subject: {
                        type: "string",
                        maxLength: 75
                    },
                    body: {
                        type: "string",
                        pattern: "^[^\\r\\n]*$"
                    }
                },
                required: [
                    "type",
                    "scope",
                    "subject",
                    "body"
                ],
                additionalProperties: false
            },
            stream: false
            }'
        )"
}

fix_json_control_chars() {
    perl -0777 -pe '
        # Remove real ANSI escape sequences
        s/\e\[[0-9;?]*[ -\/]*[@-~]//g;

        # Remove escaped ANSI sequences from JSON text
        s/\\u001[bB]\[[0-9;?]*[ -\/]*[@-~]//g;

        my $in_string = 0;
        my $escaped = 0;
        my $out = "";

        for my $c (split //, $_) {
            if ($escaped) {
                $out .= $c;
                $escaped = 0;
                next;
            }

            if ($c eq "\\") {
                $out .= "\\";
                $escaped = 1;
                next;
            }

            if ($c eq "\"") {
                $out .= "\"";
                $in_string = !$in_string;
                next;
            }

            if ($in_string) {
                # remove control characters inside JSON strings
                next if $c eq "\n" || $c eq "\t" || $c eq "\r";
            }

            $out .= $c;
        }

        $_ = $out;
    '
}

strip_terminal_codes() {
    perl -0777 -pe '
        # Real ANSI escape sequences
        s/\x1B\[[0-?]*[ -\/]*[@-~]//g;

        # JSON escaped ANSI sequences (\u001b[...)
        s/\\u001[bB]\[[0-?]*[ -\/]*[@-~]//g;

        # Literal escaped ESC forms (\033[...)
        s/\\033\[[0-?]*[ -\/]*[@-~]//g;
    '
}

start_ollama() {
    if ! curl -s http://localhost:11434/api/tags >/dev/null 2>&1; then
        echo "Starting Ollama..."
        ollama serve >/tmp/ollama.log 2>&1 &

        until curl -s http://localhost:11434/api/tags >/dev/null 2>&1; do
            sleep 0.2
        done
    fi
}

# Generates a batch of commit message suggestions and sorts them longest first.
generate_ai_message() {
    start_ollama

    clear

    print_title
    echo ""

    print_center "Generating commit message..." "$RED"

    json_msg=$(generate_subject | jq -r '.response')
    NEW_TYPE=$(printf '%s' "$json_msg" | jq -r '.type')
    NEW_SCOPE=$(printf '%s' "$json_msg" | jq -r '.scope')
    NEW_SUBJECT=$(printf '%s' "$json_msg" | jq -r '.subject')
    NEW_SUBJECT="${NEW_SUBJECT,}"
    NEW_BODY=$(printf '%s' "$json_msg" | jq -r '.body')
    
    for i in {1..3}; do
        tput bel
        sleep 0.3
    done
}

# Add AI-generated commit message suggestions batch
add_message_suggestions(){
    start_t=$SECONDS
    total_ai_msg=$((total_ai_msg + 1))
    [ "$total_ai_msg" -gt $MAX_AI_MSGS ] && total_ai_msg=MAX_AI_MSGS
    start_idx=$((total_ai_msg - MSGS_ADD -1))
    [ "$start_idx" -lt 1 ] && start_idx=1

    generate_ai_message "$start_idx" "$total_ai_msg"

    # Extract scopes from generated commit messages and collect unique scopes
    for i in $(seq "$start_idx" "$total_ai_msg"); do
        var_name="AI_MSG_$i"
        msg="${!var_name}"
        if [ -n "$msg" ]; then
            readarray -t parsed_parts < <(parse_commit_message "$msg")
            current_scope="${parsed_parts[1]}"

            if [ -n "$current_scope" ] && [ -z "${scope_map[$current_scope]}" ]; then
                unique_scopes+=("$current_scope")
                scope_map[$current_scope]=1
            fi
        fi
    done

    gen_time_info="$((SECONDS - start_t))s"
    regen_ai=0
}

