# Generates the commit message subject using Ollama.
generate_subject() {
    clean_diff_payload=$(printf '%s' "$diff_payload" \
    | sed $'s/\x1B\\[[0-9;?]*[ -\\/]*[@-~]//g' \
    | tr -d '\000-\010\013\014\016-\037')
    curl -s http://localhost:11434/api/generate \
        -H "Content-Type: application/json" \
        -d "$(jq -n \
            --arg model "qwen2.5-coder:7b" \
            --arg prompt "${SUBJECT_PROMPT}

    DIFF:
    ${clean_diff_payload}" \
            --argjson temperature "${TEMPERATURE:-0}" \
            '{
                model: $model,
                prompt: $prompt,
                options: {
                    temperature: $temperature
                },
                format: {
                    type: "object",
                    properties: {
                        type: {
                            type: "string"
                        },
                        scope: {
                            type: "string"
                        },
                        subject: {
                            type: "string",
                            maxLength: 75
                        },
                        body: {
                            type: "string",
                            pattern: "^[^\\r\\n]*$"
                        }
                    },
                    required: [
                        "type",
                        "scope",
                        "subject",
                        "body"
                    ],
                    additionalProperties: false
                },
                stream: false
            }'
        )"
}

start_ollama() {
    if ! curl -s http://localhost:11434/api/tags >/dev/null 2>&1; then
        echo "Starting Ollama..."
        ollama serve >/tmp/ollama.log 2>&1 &

        until curl -s http://localhost:11434/api/tags >/dev/null 2>&1; do
            sleep 0.2
        done
    fi
}

# Generates a batch of commit message suggestions and sorts them longest first.
generate_ai_message() {
    start_ollama

    clear

    print_title
    echo ""

    print_center "Generating commit message..." "$RED"

    json_msg=$(generate_subject | jq -r '.response')
    NEW_TYPE=$(printf '%s' "$json_msg" | jq -r '.type')
    NEW_SCOPE=$(printf '%s' "$json_msg" | jq -r '.scope')
    NEW_SUBJECT=$(printf '%s' "$json_msg" | jq -r '.subject')
    NEW_SUBJECT="${NEW_SUBJECT,}"
    NEW_BODY=$(printf '%s' "$json_msg" | jq -r '.body')
    
    for i in {1..3}; do
        tput bel
        sleep 0.3
    done
}

add_message_suggestions() {
    start_t=$SECONDS

    generate_ai_message

    readarray -t parsed_parts < <(parse_commit_message "$AI_MSG_1")
    current_scope="${parsed_parts[1]}"

    if [ -n "$current_scope" ] && [ -z "${scope_map[$current_scope]}" ]; then
        unique_scopes+=("$current_scope")
        scope_map[$current_scope]=1
    fi

    gen_time_info="$((SECONDS - start_t))s"
    regen_ai=0
}

# ----------------------------
# Menu functions
# ----------------------------

# Checks if a given choice is a valid number within a given range.
check_choice() {
    local choice="$1"
    local max="$2"
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$max" ]; then
        return 0
    else
        return 1
    fi
}

# Ask a Yes/No confirmation question using /dev/tty.
confirm_commit_message() {
    local choice

    while true; do
        clear
        print_title
        print_separator
        print_multi_line_center "$NEW_COMMIT"
        print_separator
        echo ""
        printf "Do you want to commit this message? (Y/N/B[Back to Editor]): " > /dev/tty
        read -r choice < /dev/tty

        case "$choice" in
            [Yy])
                return 0
                ;;
            [Nn])
                return 1
                ;;
            [Bb])
                return 2
                ;;
            *)
                printf "Please answer Y,N or B.\n" > /dev/tty
                ;;
        esac
    done
}

# ----------------------------
# Main Menu Loop
# ----------------------------

clear
add_message_suggestions

run_menu(){
    local new_message_msg=""

    while true; do

        clear

        print_title
        print_separator
        print_center "Subject:" "${YELLOW}"
        print_center "$NEW_TYPE($NEW_SCOPE): $NEW_SUBJECT"
        if [ "$NEW_BODY" != "" ]; then
            print_separator
            print_center "Body:" "${YELLOW}"
            print_multi_line_center "$NEW_BODY" "$RESET" 85
        fi
        print_separator
        menu_items=(
            "[S] Show Changes"
            "[C] Commit"
            "[E] Edit"
            "[R] Remove Body"
            "[D] Debug Info"
            "[X] Cancel commit"
        )

        print_menu
        print_separator
        if [ -n "$new_message_msg" ]; then
            print_tty_indent_1 "$new_message_msg"
            print_separator
            new_message_msg=""
        fi

        if [ "$new_msg" != "" ]; then
            print_center "$new_msg"
            new_msg=""
        fi

        printf " ? " > /dev/tty
        if ! IFS= read -r choice < /dev/tty; then
            choice="1"
        fi
        choice=$(printf '%s' "$choice" | tr '[:upper:]' '[:lower:]')
        case "$choice" in
            c)
                final_msg=$(build_commit_message "$NEW_TYPE" "$NEW_SCOPE" "$NEW_SUBJECT" "$NEW_BODY")
                printf "%s" "$final_msg" > "$COMMIT_MSG_FILE"
                exit 0
            ;;
            e)
                final_msg=$(build_commit_message "$NEW_TYPE" "$NEW_SCOPE" "$NEW_SUBJECT" "$NEW_BODY")
                printf "%s" "$final_msg" > "$COMMIT_MSG_FILE"

                while true; do
                    "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2> /dev/tty

                    if ! cmp -s "$COMMIT_MSG_FILE" <(printf "%s" "$final_msg"); then
                        NEW_COMMIT="$(<"$COMMIT_MSG_FILE")"
                        confirm_return=$(confirm_commit_message);
                        if [ "$confirm_return" -eq 0 ]; then
                            printf "Using edited commit message\n" > /dev/tty
                            exit 0
                        elif [ "$confirm_return" -eq 1 ]; then
                            continue 2;
                        elif [ "$confirm_return" -eq 2 ]; then
                            continue
                        fi
                    fi
                    continue 2;
                done
            ;;
            s)
                clear
                if git diff --cached | grep -q .; then
                    git diff --cached
                elif git diff HEAD | grep -q .; then
                    git diff HEAD
                else
                    git show --unified=1 --no-color HEAD
                fi
                press_continue
            ;;
            d)
                new_msg="Generation took $gen_time_info of $diff_len characters"
            ;;
            x)
                exit 1
            ;;
            *)
                new_msg="❌ Invalid input. Enter s,c,e,r,d or x" 
            ;;
        esac
    done

}

run_menu