                # calculate how many columns fit
                cols=$(( width / col_width ))
                [ "$cols" -lt 1 ] && cols=1

                for i in "${!unique_scopes[@]}"; do
                    printf "[%2d] %-15s" "$((i+1))" "${unique_scopes[$i]}" > /dev/tty

                    # newline when row is full
                    if [ $(( (i+1) % cols )) -eq 0 ]; then
                        printf "\n" > /dev/tty
                    fi
                done

                # final newline if last row is incomplete
                if [ $(( ${#unique_scopes[@]} % cols )) -ne 0 ]; then
                    printf "\n" > /dev/tty
                fi

                print_tty "Enter Custom Scope [Q]uit Menu"
                display_separator
                print_tty new_scope_msg
                print_tty "$new_scope_msg"
                printf "Choice: " > /dev/tty
                read -r scope_choice < /dev/tty
                scope_choice=$(echo "$scope_choice" | tr '[:upper:]' '[:lower:]')
                
                if [[ "$scope_choice" =~ ^[0-9]+$ ]] && [ "$scope_choice" -ge 1 ] && [ "$scope_choice" -le "${#unique_scopes[@]}" ]; then
                    new_scope="${unique_scopes[$((scope_choice-1))]}"
                    break
                elif [ "$scope_choice" = "m" ]; then
                    printf "Enter manual prefix scope: " > /dev/tty
                    read -r manual_input_scope < /dev/tty
                    manual_input_scope=$(echo "$manual_input_scope" | tr -d '[:space:]')
                    if [ -n "$manual_input_scope" ]; then
                        new_scope="$manual_input_scope"
                        break
                    else
                        new_scope_msg="❌ Manual scope cannot be empty."
                    fi
                elif [ "$scope_choice" = "q" ] || [ -z "$scope_choice" ]; then
                    break # Quit without applying changes
                else
                    # User entered a string that is not a number or 'm'/'q'. Treat as manual input.
                    new_scope="$scope_choice"
                    break
                fi
            done

            if [ -n "$new_scope" ]; then
                selected_scope="$new_scope" # Store the selected scope for display
                for i in $(seq 1 "$total_ai_msg"); do
                    var_name="AI_MSG_$i"
                    msg="${!var_name}"
                    if [ -n "$msg" ]; then
                        readarray -t parsed_parts < <(parse_commit_message "$msg")
                        current_type="${parsed_parts[0]}"
                        current_description="${parsed_parts[2]}"
                        updated_msg="${current_type}(${selected_scope}): ${current_description}"
                        printf -v "AI_MSG_$i" '%s' "$updated_msg"
                    fi
                done
                new_msg="✅ All suggestions updated to scope: $selected_scope"
            fi
            continue
            ;;
        b)
            print_tty "🧠 Creating body..."
            regen_ai=2
            continue
            ;;
        r)
            body_msg=""
            continue
            ;;

        *)
            print_tty "❌ Please choose 1-$total_ai_msg, A, T, S, B/R, C, E1-E$total_ai_msg, M."
            ;;
    esac

done

