#!/bin/bash

set -e

COMMIT_MSG_FILE="$1"
SOURCE="$2"

# Skip merge/squash commits
case "$SOURCE" in
    merge|squash)
        exit 0
        ;;
esac

# Skip if commit message already exists (e.g. -m, --amend, rebase)
if [ -s "$COMMIT_MSG_FILE" ]; then
    exit 0
fi

# Require interactive terminal
if [ ! -e /dev/tty ]; then
    exit 0
fi

DIFF=$(git diff --cached)

[ -z "$DIFF" ] && exit 0

echo > /dev/tty
echo "🤖 Git AI Assistant" > /dev/tty
echo "--------------------" > /dev/tty
echo "Generating suggestion..." > /dev/tty

if ! command -v ollama >/dev/null 2>&1; then
    echo "⚠️ Ollama not found." > /dev/tty
    exit 0
fi

AI_MSG=$(printf "%s" "$DIFF" | ollama run qwen2.5-coder:7b '
Generate a concise conventional commit message.
Output only the commit message.
No markdown.
No explanation.
One line.
')

if [ -z "$AI_MSG" ]; then
    echo "⚠️ Failed to generate commit message." > /dev/tty
    exit 0
fi

echo > /dev/tty
echo "==============================" > /dev/tty
echo "🧠 AI Suggested Commit:" > /dev/tty
echo "==============================" > /dev/tty
echo "$AI_MSG" > /dev/tty
echo "==============================" > /dev/tty
echo > /dev/tty

prompt_choice() {
    local answer

    while true; do
        printf "[A]ccept, [E]dit, [M]anual ? " > /dev/tty

        if ! IFS= read -r answer < /dev/tty; then
            echo "a"
            return
        fi

        answer=$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')

        case "$answer" in
            a|e|m|"")
                echo "${answer:-a}"
                return
                ;;
        esac

        echo "Please choose A, E or M." > /dev/tty
    done
}

choice=$(prompt_choice)

case "$choice" in

    a)
        printf "%s\n" "$AI_MSG" > "$COMMIT_MSG_FILE"
        echo "✅ AI commit accepted" > /dev/tty
        ;;

    e)
        printf "%s\n" "$AI_MSG" > "$COMMIT_MSG_FILE"
        "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
        ;;

    m)
        "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
        ;;

esac

exit 0