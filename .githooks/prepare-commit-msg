        )

        print_menu
        print_seperator
        if [ -n "$new_message_msg" ]; then
            print_tty_indent_1 "$new_message_msg"
            print_seperator
            new_message_msg=""
        fi

        if [ "$new_msg" != "" ]; then
            print_center "$new_msg"
            new_msg=""
        fi

        printf " ? " > /dev/tty
        if ! IFS= read -r choice < /dev/tty; then
            choice="1"
        fi
        choice=$(printf '%s' "$choice" | tr '[:upper:]' '[:lower:]')
        case "$choice" in
            [0-9]*)
                if check_choice "$choice" $total_ai_msg; then
                    var_name="AI_MSG_$choice"
                    final_msg=$(build_commit_message "${!var_name}" "$body_msg")
                    printf "%s" "$final_msg" > "$COMMIT_MSG_FILE"
                    echo "✅ AI commit #$choice accepted."
                    exit 0
                else
                    new_msg="❌ Please choose 1-$total_ai_msg"
                fi
            ;;
            c)
                clear
                if git diff --cached | grep -q .; then
                    git diff --cached
                elif git diff HEAD | grep -q .; then
                    git diff HEAD
                else
                    git show --unified=1 --no-color HEAD
                fi
                printf "\nPress any key to continue..." > /dev/tty
                IFS= read -r -n1 < /dev/tty
                printf "\n" > /dev/tty
            ;;

            x)
                exit 1
            ;;
        esac
    done

}

run_message_menu


