        print_center "Subject:" "${YELLOW}"
        print_center "$NEW_TYPE($NEW_SCOPE): $NEW_SUBJECT"
        if [ "$NEW_BODY" != "" ]; then
            print_seperator
            print_center "Body:" "${YELLOW}"
            print_multi_line_center "$NEW_BODY" "$RESET" 85
        fi
        print_seperator
        menu_items=(
            "[S] Show Changes"
            "[C] Commit"
            "[E] Edit"
            "[R] Remove Body"
            "[D] Debug Info"
            "[X] Exit without commiting"
        )

        print_menu
        print_seperator
        if [ -n "$new_message_msg" ]; then
            print_tty_indent_1 "$new_message_msg"
            print_seperator
            new_message_msg=""
        fi

        if [ "$new_msg" != "" ]; then
            print_center "$new_msg"
            new_msg=""
        fi

        printf " ? " > /dev/tty
        if ! IFS= read -r choice < /dev/tty; then
            choice="1"
        fi
        choice=$(printf '%s' "$choice" | tr '[:upper:]' '[:lower:]')
        case "$choice" in
            c)
                final_msg=$(build_commit_message "$NEW_SUBJECT" "$NEW_BODY")
                printf "%s" "$final_msg" > "$COMMIT_MSG_FILE"
                exit 0
            ;;
            e)
                final_msg=$(build_commit_message "$NEW_SUBJECT" "$NEW_BODY")
                printf "%s" "$final_msg" > "$COMMIT_MSG_FILE"

                "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2> /dev/tty

                if ! cmp -s "$COMMIT_MSG_FILE" <(printf "%s" "$final_msg"); then
                    if confirm_commit_message; then
                        printf "Using edited commit message\n" > /dev/tty
                        exit 0
                    else
                        continue
                    fi
                fi
                continue
            ;;
            s)
                clear
                if git diff --cached | grep -q .; then
                    git diff --cached
                elif git diff HEAD | grep -q .; then
                    git diff HEAD
                else
                    git show --unified=1 --no-color HEAD
                fi
                press_continue
            ;;
            d)
                new_msg="Generation took $gen_time_info of $diff_len characters"
            ;;
            x)
                exit 1
            ;;
            *)
                new_msg="❌ Invalid input. Enter s,c,e,r,d or x" 
            ;;
        esac
    done

}

