# Constructs the final commit message from a subject and an optional body.
build_commit_message() {
    local subject="$1"
    local body_msg="$2"

    if [ -z "$body_msg" ]; then
        printf "%s\n" "$subject"
    else
        printf "%s\n\n%s\n" "$subject" "$body_msg"
    fi
}


