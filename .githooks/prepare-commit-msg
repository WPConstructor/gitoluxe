# Constructs the final commit message from a subject and an optional body.
build_commit_message() {
    local type="$1"
    local scope="$2"
    local subject="$3"
    local body_msg="$4"

    if [ -z "$body_msg" ]; then
        printf "%s\n" "$type($scope):$subject"
    else
        printf "%s\n\n%s\n" "$type($scope):$subject" "$body_msg"
    fi
}


