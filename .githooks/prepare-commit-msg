# Displays the ASCII art title.
print_title() {
    local width line trimmed pad

    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    while IFS= read -r line; do
        # skip empty lines
        [ -z "$line" ] && continue

        # truncate line to terminal width
        trimmed="${line:0:width}"

        # compute padding for centering
        pad=$(( (width - ${#trimmed}) / 2 ))
        [ "$pad" -lt 0 ] && pad=0

        # print centered line to tty
        printf "%*s%s\n" "$pad" "" "$trimmed" > /dev/tty
    done << 'EOF'
  ________.__  __         .__                       
 /  _____/|__|/  |_  ____ |  |  __ _____  ___ ____  
/   \  ___|  \   __\/  _ \|  | |  |  \  \/  // __ \ 
\    \_\  \  ||  | (  <_> )  |_|  |  />    <\  ___/ 
 \______  /__||__|  \____/|____/____//__/\_ \\___  >
        \/                                 \/    \/ 
V1.0.0 (c) 2026 by WPConstructor - License MIT
EOF
}

# prints a text in the middle of the window
print_center() {
    local text="$1"
    local width cols padding

    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    # strip ANSI escape codes (optional safety)
    cols=${#text}

    padding=$(( (width - cols) / 2 ))
    [ "$padding" -lt 0 ] && padding=0

    printf "%*s%s\n" "$padding" "" "$text" > /dev/tty
}

# Prints a message to the TTY, wrapped to the terminal width.
print_tty() {
    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)
    echo -e "$@" | fold -s -w "$width" > /dev/tty
}

# Prints a message to the TTY, wrapped and with a 1-space indent on subsequent lines.
print_tty_indent_1() {
    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    printf "%s\n" "$@" \
        | fold -s -w "$width" \
        | sed '2,$s/^/ /' \
        > /dev/tty
}

# Prints a message to the TTY, wrapped and with a 5-space indent on subsequent lines.
print_tty_indent_5() {
    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    printf "%s\n" "$@" \
        | fold -s -w "$width" \
        | sed '2,$s/^/     /' \
        > /dev/tty
}

# Displays a horizontal line separator spanning the terminal width.
print_seperator() {
    local width char inner line

    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)
    char="-"

    # leave 1 space left + 1 space right
    inner=$((width - 2))
    [ "$inner" -lt 1 ] && inner=1

    printf -v line '%*s' "$inner" ''
    line=${line// /$char}

    printf " %s \n" "$line" > /dev/tty
}

# ----------------------------
# Menu Functions
# ----------------------------

# Print a centered, responsive multi-column menu in the terminal
print_menu() {
    local width cols i j item len pad line cell

    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    # find max columns based on typical width
    cols=$(( width / 20 ))
    [ "$cols" -lt 1 ] && cols=1

    # find max per column
    declare -a col_max

    for ((i=0; i<cols; i++)); do
        col_max[i]=0
    done

    for i in "${!menu_items[@]}"; do
        col=$(( i % cols ))
        len=${#menu_items[i]}
        [ "$len" -gt "${col_max[col]}" ] && col_max[col]=$len
    done

    # compute total width
    local row_width=0
    for ((i=0; i<cols; i++)); do
        row_width=$(( row_width + col_max[i] + 2 ))
    done

    pad=$(( (width - row_width) / 2 + 1))
    [ "$pad" -lt 0 ] && pad=0

    i=0
    while [ $i -lt ${#menu_items[@]} ]; do
        line=""

        for ((j=0; j<cols; j++)); do
            if [ $((i + j)) -lt ${#menu_items[@]} ]; then
                printf -v cell "%-*s" "${col_max[j]}" "${menu_items[i+j]}"
            else
                printf -v cell "%-*s" "${col_max[j]}" ""
            fi

            line+="$cell  "
        done

        printf "%*s%s\n" "$pad" "" "$line" > /dev/tty

        i=$((i + cols))
    done
}

