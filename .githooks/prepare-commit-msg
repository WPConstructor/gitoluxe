# Checks if a given choice is a valid number within a given range.
check_choice() {
    local choice="$1"
    local max="$2"
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$max" ]; then
        return 0
    else
        return 1
    fi
}

# Ask a Yes/No confirmation question using /dev/tty.
confirm_commit_message() {
    local choice

    while true; do
        printf "Do you want to use this edited commit message? (Y/N): " > /dev/tty
        read -r choice < /dev/tty

        case "$choice" in
            [Yy])
                return 0
                ;;
            [Nn])
                return 1
                ;;
            *)
                printf "Please answer Y or N.\n" > /dev/tty
                ;;
        esac
    done
}

