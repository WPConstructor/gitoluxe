#!/bin/bash

set -e

REQUIRED_GB=6
MAX_CHARS=7000
COMMIT_MSG_FILE="$1"
SOURCE="$2"
DEBUG=1

# ----------------------------
# 🛠️ Utilities
# ----------------------------

print_tty() {
    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)
    echo -e "$@" | fold -s -w "$width" > /dev/tty
}

print_tty_indent_5() {
    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    printf "%s\n" "$@" \
        | fold -s -w "$width" \
        | sed '2,$s/^/     /' \
        > /dev/tty
}

print_tty_indent_1() {
    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    printf "%s\n" "$@" \
        | fold -s -w "$width" \
        | sed '2,$s/^/ /' \
        > /dev/tty
}


# ----------------------------
# ⚙️ System Checks
# ----------------------------

check_resources() {
    local free_ram_gb=$(free -g | awk '/^Mem:/ {print $7}')
    local free_vram_gb=0
    
    if command -v nvidia-smi >/dev/null 2>&1; then
        free_vram_gb=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | awk '{sum+=$1} END {print sum/1024}')
    fi
    free_vram_gb=${free_vram_gb:-0}

    local ollama_used_gb=$(ollama ps 2>/dev/null | awk '
        NR > 1 {
            size=$3; unit=$4
            if (unit == "GB") sum += size
            else if (unit == "MB") sum += size / 1024
        }
        END { printf "%.2f", sum + 0 }
    ')
    ollama_used_gb=${ollama_used_gb:-0}

    local total_mem_gb=$(awk "BEGIN {print $free_ram_gb + $free_vram_gb + $ollama_used_gb}")

    if (( $(echo "$total_mem_gb < $REQUIRED_GB" | bc -l) )); then
        print_tty "⚠️ Warning: Low memory detected (${total_mem_gb} GB available). Qwen 2.5 7B may run poorly."
        read -r -p "Continue anyway? (Y/N): " choice < /dev/tty > /dev/tty

        case "$choice" in
            [Yy]*) print_tty "Continuing..." ;;
            [Nn]*)
                print_tty "Exiting..."
                exit 1
                ;;
            *)
                print_tty "Invalid choice. Exiting..."
                exit 1
                ;;
        esac
    fi
}

check_resources

case "$SOURCE" in
    merge|squash|template)
        echo "Skipping AI commit generation ($SOURCE)"
        exit 0
        ;;
    commit|amend)
        is_amend=1
        ;;
esac

existing_msg=$(cat "$COMMIT_MSG_FILE" 2>/dev/null)

# ----------------------------
# 🚫 Check if "gitai" message
# ----------------------------
case "$existing_msg" in
    "gitoluxe"|"ai")
        ;;
    *)
        exit 0
        # Allow amend commits to proceed even if the file isn't empty. Todo uncomment when this should be used. Test if
        # it runs without this.
        #if [ "$SOURCE" != "commit" ]; then
        #    exit 0
        #fi
        ;;
esac

# Prevent running interactive commands when /dev/tty is not available
if [ ! -e /dev/tty ]; then
    exit 0
fi

# ----------------------------
# 📦 Collect staged data
# ----------------------------

staged_files=$(git diff --cached --name-status)
staged_stat=$(git diff --cached --stat)
staged_diff=$(git diff --cached --unified=1 --no-color | head -c "$MAX_CHARS")

SHA="$3"

# If nothing staged, check commit context (amend / override)
if [ -z "$staged_files" ]; then
    staged_files=$(git show --name-status --format="" HEAD 2>/dev/null | head -c "$MAX_CHARS")
    staged_stat=$(git show --stat --format="" HEAD 2>/dev/null | head -c "$MAX_CHARS")
    staged_diff=$(git diff HEAD --unified=1 --no-color 2>/dev/null | head -c "$MAX_CHARS")

    if [ -z "$staged_diff" ]; then
        staged_diff=$(git show --unified=1 --no-color HEAD 2>/dev/null | head -c "$MAX_CHARS")
    fi
    is_amend=1
fi

if [ -z "$staged_files" ]; then
    exit 0
fi

diff_len=${#staged_diff}
[ "$diff_len" -eq "$MAX_CHARS" ] && staged_diff="${staged_diff}\n\n... (truncated)"

# ----------------------------
# 🧠 AI Prompts & Data
# ----------------------------

diff_payload=$(printf "
STAGED FILES (IMPORTANT):
%s

STAGED STAT:
%s

SUMMARIZED DIFF:
%s
" "$staged_files" "$staged_stat" "$staged_diff" | sed -E '
    s|^([+-])[[:space:]]*#|\1 COMMENT:|;
    s|^([+-])[[:space:]]*//|\1 COMMENT:|;
    s|^([+-])[[:space:]]*/\*|\1 COMMENT:|;
')

SUBJECT_PROMPT="Generate exactly one Conventional Commit message from the provided diff.

Requirements:

* Output exactly one line.
* Do not output markdown, explanations, quotes, code fences, or any additional text.
* Format: type(scope): description
* Omit the scope if it is not obvious.
* Maximum length: 120 characters.
* Use imperative mood (e.g. "add", "fix", "update", "remove").
* Describe the primary outcome or purpose of the change, not implementation details.

Type selection (choose the most significant change):

* feat: new user-visible functionality or behavior.
* fix: correction of incorrect behavior.
* refactor: internal restructuring without behavior change.
* style: formatting, whitespace, linting, or code style only.
* docs: documentation-only changes.
* test: tests only.
* perf: performance improvements.
* chore: maintenance, tooling, configuration, or housekeeping.
* release: version release changes.
* remove: removal of functionality, code, or files.
* build: build system or dependency management changes.
* ci: CI/CD changes.
* security: security-related fixes or improvements.
* i18n: internationalization or localization changes.
* deps: dependency updates.
* hotfix: urgent production fix.
* ui: user interface or visual changes.
* merge: branch merge.
* revert: revert of previous changes.
* move: file or directory moves/renames.
* cleanup: minor cleanup and non-functional improvements.

Classification rules:

* Classify based on behavior, not code volume.
* New functions, refactoring, renaming, moving files, comments, formatting, labels, and cleanup are not feats by themselves.
* Documentation changes are docs unless accompanied by a more significant code change.
* Comments provide context but do not affect the type.
* If behavior does not change, prefer refactor over feat.
* If any user-visible functionality is added, prefer feat.
* If any incorrect behavior is corrected, prefer fix.
* Choose the single best type; do not combine types.

Available scopes (use only if clearly applicable):
githooks, ai, ollama, commit, cli, installer

Return only the commit message."

BODY_PROMPT="Generate only the Git commit body.

Rules:
- Plain text only.
- No subject line.
- No commit type.
- No markdown, bullets, JSON, code blocks, emojis, or explanations.
- Output only the body.

Interpretation:
- .md files are documentation, not source code.
- Describe documentation changes as documentation changes.
- Comments provide context but do not imply behavior changes.
- Do not infer features from comments, labels, annotations, formatting, or documentation.
- Behavior changes come only from executable code changes.

Format:
- First line: concise summary of what changed and why.
- Up to 4 additional lines with important details.
- Focus on behavior, user impact, and key changes.
- Ignore minor refactors unless they affect behavior.

Example:

Adds interactive commit selection to improve workflow

Allows reviewing AI-generated commit messages before use.
Supports regenerating or editing suggestions."

# ----------------------------
# 🧠 AI generator functions
# ----------------------------

generate_body() {
    printf "%s" "$diff_payload" | ollama run qwen2.5-coder:7b "$BODY_PROMPT"
}

generate_subject() {
    printf "%s" "$diff_payload" | ollama run qwen2.5-coder:7b "$SUBJECT_PROMPT"
}

build_commit_message() {
    local subject="$1"
    local body_msg="$2"

    if [ -z "$body_msg" ]; then
        printf "%s\n" "$subject"
    else
        printf "%s\n\n%s\n" "$subject" "$body_msg"
    fi
}

cleanup_ai_msg() {
    echo "$1" | sed -E 's/[[:space:]]+/ /g; s/`//g' | tr -d '\n\t' | cut -c1-150
}

check_choice() {
    local choice="$1"
    local max="$2"
    [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$max" ]
}

generate_batch() {
    local start=$1
    local end=$2
    local idx=$start
    echo "Generating commit message suggestions..." > /dev/tty
    while [ "$idx" -le "$end" ]; do
        msg=$(generate_subject)
        msg=$(cleanup_ai_msg "$msg")
        printf -v "AI_MSG_$idx" '%s' "$msg"
        idx=$((idx + 1))
    done
}

print_separator() {
    local width char line

    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)
    char="-"

    printf -v line '%*s' "$width" ''
    line=${line// /$char}

    printf "%s\n" "$line" > /dev/tty
}

get_type_desc() {
    choice="$1"

    types=("feat" "fix" "refactor" "style" "docs" "test" "perf" "chore" "release" "remove" "build" "ci" "security" "i18n" "deps" "hotfix" "ui" "merge" "revert" "move" "cleanup")

    descs=(
        "Introduces a new user-facing feature or capability. This includes adding new functionality that changes or extends behavior. Only use when actual new behavior is delivered to the user."
        "Fixes a bug or incorrect behavior in the system. Resolves an issue where the software does not work as intended. Does not introduce new features."
        "Restructures code without changing external behavior. Used for improving internal design, readability, or maintainability. No functional changes should result."
        "Changes related to code style, formatting, or whitespace only. Does not affect logic or behavior. Typically used for linting or formatting adjustments."
        "Updates documentation files only, such as README or inline docs. No production or test code is modified. Used to clarify or improve project documentation."
        "Adds new tests or updates existing tests. Ensures correctness of functionality without changing production behavior. May include test fixes or coverage improvements."
        "Improves performance without changing observable behavior. Focuses on optimizing speed, memory usage, or efficiency. No functional changes are introduced."
        "General maintenance tasks, tooling updates, or minor internal changes. Includes non-feature work that supports development workflows. Does not affect user-facing behavior."
        "Prepares or performs a new software release. Includes versioning, tagging, or release-related adjustments. No functional changes should be introduced in this commit."
        "Removes dead code, unused files, or obsolete functionality. Ensures cleanup of no-longer-needed components. Must not break existing behavior."
        "Changes related to build system, packaging, or external build dependencies. Includes configuration for bundlers or build tools. Does not change runtime logic directly."
        "Updates continuous integration or deployment configurations. Affects CI pipelines, workflows, or automation scripts. No application logic changes are intended."
        "Fixes or mitigates a security vulnerability. Addresses issues that could lead to unauthorized access or exploitation. Should be treated as high priority changes."
        "Adds or updates internationalization or localization support. Includes translations or locale-specific formatting changes. Does not change core functionality."
        "Updates external dependencies or libraries. Includes version bumps, removals, or replacements. May include compatibility adjustments."
        "Fixes a critical or urgent issue affecting production systems. Used when immediate correction is required. Often a fast-tracked version of a bug fix."
        "Changes related to user interface or visual presentation. Includes styling, layout, or UX adjustments. Does not modify core business logic."
        "Combines branches or integrates separate lines of development. Used for merge commits only. Does not introduce new feature logic."
        "Reverts a previous commit or set of changes. Restores prior state of the codebase. Used when a change needs to be undone."
        "Moves or renames files or directories without changing content. Helps reorganize project structure. No functional changes are introduced."
        "General cleanup of codebase and minor improvements. Includes small refactors, simplifications, or removals. Does not affect behavior."
    )

    i=0
    while [ $i -lt ${#types[@]} ]; do
        if [ "${types[$i]}" = "$choice" ]; then
            printf "%s\n" "${descs[$i]}"
            return 0
        fi
        i=$((i + 1))
    done

    return 1
}

print_menu() {
    local width cols i items count col_width

    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    items=(
        " [1-$total_ai_msg] Accept"
        " [A] Add Suggestions"
        " [T] Prefix Type"
        " Enter Type for Type description"
        " [S] Prefix Scope"
        " [B] Add Body"
        " [R] Remove Body"
        " [C] Changes"
        " [E1-E$total_ai_msg] Edit Suggestion"
        " [M] Edit Manually"
        " [X] Exit"
    )

    count=${#items[@]}

    # compute best column count (at least 1 column)
    col_width=24
    cols=$(( width / col_width ))
    [ "$cols" -lt 1 ] && cols=1

    echo "" > /dev/tty

    for ((i=0; i<count; i++)); do
        printf "%-${col_width}s" "${items[i]}"

        # line break after reaching column limit
        if (( (i + 1) % cols == 0 )); then
            printf "\n"
        fi
    done
} > /dev/tty

title() {
    local width line trimmed pad

    width=$(tput cols < /dev/tty 2>/dev/null || echo 80)

    while IFS= read -r line; do
        # skip empty lines
        [ -z "$line" ] && continue

        # truncate line to terminal width
        trimmed="${line:0:width}"

        # compute padding for centering
        pad=$(( (width - ${#trimmed}) / 2 ))
        [ "$pad" -lt 0 ] && pad=0

        # print centered line to tty
        printf "%*s%s\n" "$pad" "" "$trimmed" > /dev/tty
    done << 'EOF'
  ________.__  __         .__                       
 /  _____/|__|/  |_  ____ |  |  __ _____  ___ ____  
/   \  ___|  \   __\/  _ \|  | |  |  \  \/  // __ \ 
\    \_\  \  ||  | (  <_> )  |_|  |  />    <\  ___/ 
 \______  /__||__|  \____/|____/____//__/\_ \\___  >
        \/                                 \/    \/ 
V1.0.0
EOF
}

regen_ai=1
total_ai_msg=0
gen_time_info=""

# New global variables for scope functionality
selected_scope=""

# ----------------------------
# 🧠 AI generator functions (continued)
# ----------------------------

# Function to parse commit message into type, scope, and description
parse_commit_message() {
    local msg="$1"
    local _type=""
    local _scope=""
    local _description="$msg" # Default to full message as description

    if [[ "$msg" =~ ^([^(: ]+)\(([^)]*)\):\s*(.*)$ ]]; then
        _type="${BASH_REMATCH[1]}"
        _scope="${BASH_REMATCH[2]}"
        _description="${BASH_REMATCH[3]}"
    elif [[ "$msg" =~ ^([^:]+):\s*(.*)$ ]]; then
        _type="${BASH_REMATCH[1]}"
        _description="${BASH_REMATCH[2]}"
    fi
    echo "$_type"
    echo "$_scope"
    echo "$_description"
}
selected_type=""
body_time_info=""
body_msg=""
new_msg=""

# ----------------------------
# 🎛 UI loop
# ----------------------------
while true; do

    clear

    # ----------------------------
    # 🤖 Add 5 AI Message Suggestions
    # ----------------------------
    if [ "$regen_ai" = "1" ]; then
        start_t=$SECONDS
        total_ai_msg=$((total_ai_msg + 5))
        [ "$total_ai_msg" -gt 20 ] && total_ai_msg=20
        start_idx=$((total_ai_msg - 4))
        [ "$start_idx" -lt 1 ] && start_idx=1

        generate_batch "$start_idx" "$total_ai_msg"
        gen_time_info="$((SECONDS - start_t))s"
        regen_ai=0
    fi

    # ----------------------------
    # 🤖 Generate AI body message
    # ----------------------------
    if [ "$regen_ai" = "2" ]; then
        start_t=$SECONDS
        echo "Generating commit body message..." > /dev/tty
        body_msg=$(generate_body)
        body_msg="$(
        echo "$body_msg" \
        | sed 's/```.*//g' \
        | sed 's/`//g' \
        | sed 's/\*\*//g' \
        | sed '/^[[:space:]]*$/d'
        )"
        body_time_info=" ($((SECONDS - start_t))s)"
        regen_ai=0
    fi

    title
    
    # ----------------------------
    # 🎮 Menu
    # ----------------------------

    print_separator
    print_menu

    # ----------------------------
    # 🧠 Display suggestions
    # ----------------------------

    echo "" > /dev/tty 
    print_separator
    debug_str=""

    if [ "${DEBUG:-0}" -eq 1 ]; then
        debug_str=" ($gen_time_info / $diff_len chars)"
    fi
    echo "" > /dev/tty
    print_tty " AI Generated Commits$debug_str:"
    echo "" > /dev/tty

    idx=1
    display_count=0
    while [ "$idx" -le 20 ]; do
        var_name="AI_MSG_$idx"  
        msg="${!var_name}"

        if [ -n "$msg" ]; then
            print_tty_indent_5 " [$idx] $msg"
            display_count=$((display_count + 1))
            print_tty ""

            # Empty line after 5 items
            if [ $((display_count % 5)) -eq 0 ]; then
                print_tty ""
            fi
        fi
        idx=$((idx + 1))
    done

    if [ -z "$body_msg" ]; then
        print_tty " No body"
    else
        print_separator
        print_tty " Body:"
        print_tty_indent_1 " $body_msg$body_time_info"
    fi

    print_separator

    # ----------------------------
    # Choice
    # ----------------------------

    echo "" > /dev/tty
    if [ -n "$new_msg" ]; then
        print_tty "$new_msg"
        new_msg=""
    fi

    printf "Choice: " > /dev/tty
    if ! IFS= read -r choice < /dev/tty; then
        choice="1"
    fi
    choice=$(printf '%s' "$choice" | tr '[:upper:]' '[:lower:]')

    if desc=$(get_type_desc "$choice"); then
        new_msg="$choice\n\n$desc\n"
        continue
    fi

    case "$choice" in
        x)
            print_tty "Commit canceled"
            exit 1
            ;;

        [0-9]*)
            if check_choice "$choice" $total_ai_msg; then
                var_name="AI_MSG_$choice"
                final_msg=$(build_commit_message "${!var_name}" "$body_msg")
                printf "%s" "$final_msg" > "$COMMIT_MSG_FILE"
                new_msg="✅ AI commit #$choice accepted"
                exit 0
            else
                new_msg="❌ Please choose 1-$total_ai_msg"
            fi
            ;;
        e[0-9]*)
            idx="${choice#e}"
            if check_choice "$idx" $total_ai_msg; then
                var_name="AI_MSG_$idx"
                final_msg=$(build_commit_message "${!var_name}" "$body_msg")
                printf "%s" "$final_msg" > "$COMMIT_MSG_FILE"
                exec < /dev/tty
                exec > /dev/tty
                exec 2> /dev/tty
                "${EDITOR:-nano}" "$COMMIT_MSG_FILE"
                exit 0
            else
                new_msg="❌ Please choose 1-$total_ai_msg"
            fi
            ;;
        m)
            > "$COMMIT_MSG_FILE"
            exec < /dev/tty
            exec > /dev/tty
            exec 2> /dev/tty            
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE"
            exit 0
            ;;

        c)
            if git diff --cached | grep -q .; then
                git diff --cached
            elif git diff HEAD | grep -q .; then
                git diff HEAD
            else
                git show --unified=1 --no-color HEAD
            fi
            ;;

        a)
            new_msg="🧠 Adding 5 AI commit suggestions..."
            regen_ai=1
            continue
            ;;
        t)
            types=("feat" "fix" "refactor" "style" "docs" "test" "perf" "chore" "release" "remove" "build" "ci" "security" "i18n" "deps" "hotfix" "ui" "merge" "revert" "move" "cleanup")
            new_type=""
            new_type_msg=""

            while true; do
                clear
                print_separator
                print_tty "Select Prefix Type (Stored: ${selected_type:-None}):"
                for i in "${!types[@]}"; do
                    printf "[%2d] %-10s " "$((i+1))" "${types[$i]}" > /dev/tty
                    if [ $(( (i+1) % 3 )) -eq 0 ]; then print_tty ""; fi
                done
                [ $(( ${#types[@]} % 3 )) -ne 0 ] && print_tty ""
                print_tty "[M]anual Input  [Q]uit Menu"
                print_tty "Enter the type for a description of the type"
                print_separator
                print_tty new_type_msg
                printf "Choice: " > /dev/tty
                read -r type_choice < /dev/tty
                type_choice=$(echo "$type_choice" | tr '[:upper:]' '[:lower:]')
                
                if desc=$(get_type_desc "$type_choice"); then
                    new_type_msg="$type_choice\n\n$desc\n"
                    continue
                fi

                if [[ "$type_choice" =~ ^[0-9]+$ ]] && [ "$type_choice" -ge 1 ] && [ "$type_choice" -le "${#types[@]}" ]; then
                    new_type="${types[$((type_choice-1))]}"
                    break
                elif [ "$type_choice" = "m" ]; then
                    printf "Enter manual prefix type: " > /dev/tty
                    read -r new_type < /dev/tty
                    new_type=$(echo "$new_type" | tr -d '[:space:]')
                    [ -n "$new_type" ] && break
                elif [ "$type_choice" = "q" ] || [ -z "$type_choice" ]; then
                    break
                else
                    new_type_msg="❌ Invalid choice."
                fi
            done

            if [ -n "$new_type" ]; then
                selected_type="$new_type"
                for i in $(seq 1 "$total_ai_msg"); do
                    var_name="AI_MSG_$i"
                    msg="${!var_name}"
                    if [ -n "$msg" ]; then
                        updated_msg=$(echo "$msg" | sed -E "s/^[^(: ]+/$selected_type/")
                        printf -v "AI_MSG_$i" '%s' "$updated_msg"
                    fi
                done
                new_msg="✅ All suggestions updated to type: $selected_type"
            fi
            continue
            ;;
        s)
            unique_scopes=()
            declare -A scope_map # To ensure uniqueness and order

            for i in $(seq 1 "$total_ai_msg"); do
                var_name="AI_MSG_$i"
                msg="${!var_name}"
                if [ -n "$msg" ]; then
                    readarray -t parsed_parts < <(parse_commit_message "$msg")
                    current_scope="${parsed_parts[1]}" # This is the scope part

                    if [ -n "$current_scope" ] && [ -z "${scope_map[$current_scope]}" ]; then
                        unique_scopes+=("$current_scope")
                        scope_map[$current_scope]=1
                    fi
                fi
            done

            new_scope=""
            new_scope_msg=""

            while true; do
                clear
                print_separator
                print_tty "Select Prefix Scope (Stored: ${selected_scope:-None}):"
                for i in "${!unique_scopes[@]}"; do
                    printf "[%2d] %-10s " "$((i+1))" "${unique_scopes[$i]}" > /dev/tty
                    if [ $(( (i+1) % 3 )) -eq 0 ]; then print_tty ""; fi
                done
                [ $(( ${#unique_scopes[@]} % 3 )) -ne 0 ] && print_tty ""
                print_tty "[M]anual Input  [Q]uit Menu"
                print_separator
                print_tty "$new_scope_msg"
                printf "Choice: " > /dev/tty
                read -r scope_choice < /dev/tty
                scope_choice=$(echo "$scope_choice" | tr '[:upper:]' '[:lower:]')
                
                if [[ "$scope_choice" =~ ^[0-9]+$ ]] && [ "$scope_choice" -ge 1 ] && [ "$scope_choice" -le "${#unique_scopes[@]}" ]; then
                    new_scope="${unique_scopes[$((scope_choice-1))]}"
                    break
                elif [ "$scope_choice" = "m" ]; then
                    printf "Enter manual prefix scope: " > /dev/tty
                    read -r manual_input_scope < /dev/tty
                    manual_input_scope=$(echo "$manual_input_scope" | tr -d '[:space:]')
                    if [ -n "$manual_input_scope" ]; then
                        new_scope="$manual_input_scope"
                        break
                    else
                        new_scope_msg="❌ Manual scope cannot be empty."
                    fi
                elif [ "$scope_choice" = "q" ] || [ -z "$scope_choice" ]; then
                    break # Quit without applying changes
                else
                    # User entered a string that is not a number or 'm'/'q'. Treat as manual input.
                    new_scope="$scope_choice"
                    break
                fi
            done

            if [ -n "$new_scope" ]; then
                selected_scope="$new_scope" # Store the selected scope for display
                for i in $(seq 1 "$total_ai_msg"); do
                    var_name="AI_MSG_$i"
                    msg="${!var_name}"
                    if [ -n "$msg" ]; then
                        readarray -t parsed_parts < <(parse_commit_message "$msg")
                        current_type="${parsed_parts[0]}"
                        current_description="${parsed_parts[2]}"
                        updated_msg="${current_type}(${selected_scope}): ${current_description}"
                        printf -v "AI_MSG_$i" '%s' "$updated_msg"
                    fi
                done
                new_msg="✅ All suggestions updated to scope: $selected_scope"
            fi
            continue
            ;;
        b)
            print_tty "🧠 Creating body..."
            regen_ai=2
            continue
            ;;
        r)
            body_msg=""
            continue
            ;;

        *)
            print_tty "❌ Please choose 1-$total_ai_msg, A, T, S, B/R, C, E1-E$total_ai_msg, M."
            ;;
    esac

done

exit 0;
