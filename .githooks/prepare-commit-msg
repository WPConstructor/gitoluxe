#!/bin/bash

set -e

COMMIT_MSG_FILE="$1"
SOURCE="$2"

# ----------------------------
# 🚫 Skip unsafe contexts
# ----------------------------
case "$SOURCE" in
    merge|squash)
        exit 0
        ;;
esac

if [ -s "$COMMIT_MSG_FILE" ]; then
    exit 0
fi

if [ ! -e /dev/tty ]; then
    exit 0
fi

# ----------------------------
# 📦 Collect staged data
# ----------------------------

STAGED_FILES=$(git diff --cached --name-status)
STAGED_STAT=$(git diff --cached --stat)
DIFF=$(git diff --cached --unified=1)

# If nothing staged
[ -z "$STAGED_FILES" ] && exit 0

# ----------------------------
# 🧠 Build AI input
# ----------------------------

INPUT=$(printf "
STAGED FILES (IMPORTANT):
%s

STAGED STAT:
%s

FULL DIFF:
%s
" "$STAGED_FILES" "$STAGED_STAT" "$DIFF")

# ----------------------------
# 🧠 AI generator function
# ----------------------------
generate_ai() {
printf "%s" "$INPUT" | ollama run qwen2.5-coder:7b "
You are a senior software engineer and Git expert.

Analyze the git diff and determine the PRIMARY purpose of the change.

IMPORTANT RULE ABOUT FILE TYPES:
- If the change affects .md (Markdown) files, treat them as documentation text only.
- DO NOT treat Markdown files as source code.
- Changes in .md files are always docs unless they clearly describe a new feature being introduced in code.

---

STEP 1: DETERMINE PURPOSE

Determine whether the diff introduces ANY new user-visible functionality.

User-visible functionality includes:
- new menu options
- new commands
- new CLI flags
- new prompts
- new configuration options
- new user interactions
- new features or capabilities

If YES:
- commit type MUST be feat
- ignore refactoring noise

If NO:
Choose the most appropriate type:
- fix = bug correction
- refactor = code restructuring without behavior change
- chore = maintenance, cleanup, tooling
- docs = documentation or markdown changes
- test = test changes
- perf = performance improvements
- build = build system changes
- ci = CI/CD changes

---

STEP 2: SCOPE DETECTION
Choose scope from:
- githooks
- ai
- ollama
- commit
- cli
- installer

If unclear, omit scope.

---

STEP 3: OUTPUT FORMAT

Return EXACTLY ONE Conventional Commit message:

type(scope): description

RULES:
- output ONLY the commit message
- no markdown
- no explanations
- no code blocks
- no JSON
- no period at end
- max 72 characters
- imperative mood
- prefer feat over refactor when both apply
- describe user impact, not implementation details

GOOD EXAMPLES:
feat(githooks): add staged diff preview before commit
feat(cli): add interactive commit selection
fix(ai): handle empty diff generation
chore(installer): update Ollama installation logic
refactor(commit): simplify message generation flow
docs(readme): improve installation instructions
"
}

regen_ai=1

# ----------------------------
# 🎛 UI loop (safe)
# ----------------------------
while true; do

    # ----------------------------
    # 🤖 Generate AI message
    # ----------------------------
    if [ "$regen_ai" = "1" ]; then
        AI_MSG=$(generate_ai)
        regen_ai=0
    fi

    if [ -z "$AI_MSG" ]; then
        echo "⚠️ AI generation failed. Retrying..." > /dev/tty
        continue
    fi

    # ----------------------------
    # 🧠 Show suggestion
    # ----------------------------
    echo > /dev/tty
    echo "==============================" > /dev/tty
    echo "🧠 AI Suggested Commit:" > /dev/tty
    echo "==============================" > /dev/tty
    echo "$AI_MSG" > /dev/tty
    echo "==============================" > /dev/tty

    # ----------------------------
    # 🎮 Menu
    # ----------------------------
    printf "[A]ccept, [R]egenerate, [S]how Changes, [E]dit, [M]anual ? " > /dev/tty

    if ! IFS= read -r choice < /dev/tty; then
        choice="a"
    fi

    choice=$(printf '%s' "$choice" | tr '[:upper:]' '[:lower:]')

    case "$choice" in

        a|"")
            printf "%s\n" "$AI_MSG" > "$COMMIT_MSG_FILE"
            echo "✅ AI commit accepted" > /dev/tty
            exit 0
            ;;

        e)
            printf "%s\n" "$AI_MSG" > "$COMMIT_MSG_FILE"
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
            exit 0
            ;;

        m)
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
            exit 0
            ;;

        s)
            git diff --cached
            ;;

        r)
            echo "🔄 regenerating AI commit..." > /dev/tty
            regen_ai=1
            continue   # 🔥 correct way to restart loop
            ;;

        *)
            echo "Please choose A, E, M, S or R." > /dev/tty
            ;;
    esac

done

exit 0;

#test