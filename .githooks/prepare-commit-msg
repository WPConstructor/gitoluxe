#!/bin/bash

set -e

COMMIT_MSG_FILE="$1"
SOURCE="$2"

# ----------------------------
# 🚫 Skip unsafe contexts
# ----------------------------
case "$SOURCE" in
    merge|squash)
        exit 0
        ;;
esac

if [ -s "$COMMIT_MSG_FILE" ]; then
    exit 0
fi

if [ ! -e /dev/tty ]; then
    exit 0
fi

# ----------------------------
# 📦 Collect staged data
# ----------------------------

STAGED_FILES=$(git diff --cached --name-status)
STAGED_STAT=$(git diff --cached --stat)
DIFF=$(git diff --cached --unified=1)

# If nothing staged
[ -z "$STAGED_FILES" ] && exit 0

# ----------------------------
# 🧠 Build AI INPUT_PROMPT
# ----------------------------

INPUT_PROMPT=$(printf "
STAGED FILES (IMPORTANT):
%s

STAGED STAT:
%s

FULL DIFF:
%s
" "$STAGED_FILES" "$STAGED_STAT" "$DIFF")

# ----------------------------
# 🧠 AI generator function
# ----------------------------
generate_ai() {
printf "%s" "$INPUT_PROMPT" | ollama run qwen2.5-coder:7b "
You are a senior software engineer and Git expert.

You generate ONLY Git Conventional Commit messages.

You MUST follow ALL instructions exactly. No exceptions.

---

IMPORTANT RULES ABOUT FILE TYPES:
- If the change affects .md (Markdown) files, treat them ONLY as documentation text.
- NEVER treat Markdown files as source code.
- Markdown changes are ALWAYS docs unless they clearly accompany a code feature change.

---

STEP 1: DETERMINE PURPOSE

Determine whether the change introduces ANY user-visible functionality.

User-visible functionality includes:
- new menu options
- new commands
- new CLI flags
- new prompts
- new configuration options
- new user interactions
- new features or capabilities

If YES:
- commit type MUST be feat
- ignore refactoring noise

If NO:
Choose exactly ONE of:
- fix = bug correction
- refactor = code restructuring without behavior change
- chore = maintenance or tooling
- docs = documentation or markdown changes
- test = test changes
- perf = performance improvements
- build = build system changes
- ci = CI/CD changes

---

STEP 2: SCOPE DETECTION

Choose ONE scope if clearly applicable:
- githooks
- ai
- ollama
- commit
- cli
- installer

If unclear, omit scope.

---

STEP 3: OUTPUT FORMAT (STRICT HARD CONSTRAINT)

You MUST output EXACTLY ONE LINE and NOTHING ELSE.

ABSOLUTE RULES:
- Output MUST be a single line only
- Output MUST NOT contain newline characters
- Output MUST NOT contain markdown (no tripple backticks or backticks)
- Output MUST NOT contain explanations
- Output MUST NOT contain multiple suggestions
- Output MUST NOT contain prefixes or suffixes
- Output MUST NOT contain bullet points
- Output MUST NOT contain JSON
- Output MUST NOT end with a period
- Output MUST be plain text only
- Output MUST be ≤ 75 characters total
- Output MUST follow this format exactly:

type(scope): description

---

GOOD EXAMPLES:
feat(githooks): add staged diff preview before commit
feat(cli): add interactive commit selection
fix(ai): handle empty diff generation
chore(installer): update Ollama installation logic
refactor(commit): simplify message generation flow
docs(readme): improve installation instructions

---

FINAL RULE:
Return ONLY the commit message. Nothing else.
"
}

regen_ai=1

# ----------------------------
# 🎛 UI loop (safe)
# ----------------------------
while true; do

    # ----------------------------
    # 🤖 Generate AI message
    # ----------------------------
    if [ "$regen_ai" = "1" ]; then
        AI_MSG_1=$(generate_ai)
        AI_MSG_2=$(generate_ai)
        AI_MSG_3=$(generate_ai)
        AI_MSG_1=$(echo "$AI_MSG_1" | tr '\n' ' ' | sed 's/`//g')
        AI_MSG_1=${AI_MSG_1:0:100}
        AI_MSG_1=$(printf "%s" "$AI_MSG_1" | tr -s '[:space:]' ' ')
        AI_MSG_2=$(echo "$AI_MSG_2" | tr '\n' ' ' | sed 's/`//g')
        AI_MSG_2=${AI_MSG_2:0:100}
        AI_MSG_2=$(printf "%s" "$AI_MSG_2" | tr -s '[:space:]' ' ')
        AI_MSG_3=$(echo "$AI_MSG_3" | tr '\n' ' ' | sed 's/`//g')
        AI_MSG_3=${AI_MSG_3:0:100}
        AI_MSG_3=$(printf "%s" "$AI_MSG_3" | tr -s '[:space:]' ' ')
        regen_ai=0
    fi

    # ----------------------------
    # 🧠 Show suggestion
    # ----------------------------
    echo > /dev/tty
    echo "==============================" > /dev/tty
    echo "🧠 AI Suggested Commit:" > /dev/tty
    echo "==============================" > /dev/tty
    echo "[1] $AI_MSG_1" > /dev/tty
    echo "[2] $AI_MSG_2" > /dev/tty
    echo "[3] $AI_MSG_3" > /dev/tty
    echo "==============================" > /dev/tty

    # ----------------------------
    # 🎮 Menu
    # ----------------------------
    printf "Accept [1-3], [R]egenerate, [S]how Changes, Edit [E1,E2,E3], [M]anual ? " > /dev/tty

    if ! IFS= read -r choice < /dev/tty; then
        choice="1"
    fi

    choice=$(printf '%s' "$choice" | tr '[:upper:]' '[:lower:]')

    case "$choice" in

        1)
            printf "%s\n" "$AI_MSG_1" > "$COMMIT_MSG_FILE"
            echo "✅ AI commit accepted" > /dev/tty
            exit 0
            ;;

        2)
            printf "%s\n" "$AI_MSG_2" > "$COMMIT_MSG_FILE"
            echo "✅ AI commit accepted" > /dev/tty
            exit 0
            ;;

        3)
            printf "%s\n" "$AI_MSG_3" > "$COMMIT_MSG_FILE"
            echo "✅ AI commit accepted" > /dev/tty
            exit 0
            ;;

        e1)
            printf "%s\n" "$AI_MSG_1" > "$COMMIT_MSG_FILE"
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
            exit 0
            ;;

        e2)
            printf "%s\n" "$AI_MSG_2" > "$COMMIT_MSG_FILE"
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
            exit 0
            ;;

        e3)
            printf "%s\n" "$AI_MSG_3" > "$COMMIT_MSG_FILE"
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
            exit 0
            ;;

        m)
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
            exit 0
            ;;

        s)
            git diff --cached
            ;;

        r)
            echo "🔄 regenerating AI commit..." > /dev/tty
            regen_ai=1
            continue   # 🔥 correct way to restart loop
            ;;

        *)
            echo "Please choose A, E, M, S or R." > /dev/tty
            ;;
    esac

done

exit 0;

#test