#!/bin/bash

set -e

COMMIT_MSG_FILE="$1"
SOURCE="$2"

# ----------------------------
# 🚫 Skip unsafe contexts
# ----------------------------
case "$SOURCE" in
    merge|squash)
        exit 0
        ;;
esac

if [ -s "$COMMIT_MSG_FILE" ]; then
    exit 0
fi

if [ ! -e /dev/tty ]; then
    exit 0
fi

# ----------------------------
# 📦 Get staged diff ONCE
# ----------------------------
DIFF=$(git diff --cached --unified=1 | head -c 6000)

[ -z "$DIFF" ] && exit 0

# ----------------------------
# 🧠 AI generator function
# ----------------------------
generate_ai() {
    printf "%s" "$DIFF" | ollama run qwen2.5-coder:7b "
You are a senior software engineer and Git expert.

Generate exactly ONE Conventional Commit message.

Rules:
- type(scope): description
- max 72 characters
- no markdown
- no explanation
- no period at end
- prefer feat over refactor when user-visible changes exist
"
}

# ----------------------------
# 🎛 UI loop (safe)
# ----------------------------
while true; do

    # ----------------------------
    # 🤖 Generate AI message
    # ----------------------------
    AI_MSG=$(generate_ai)

    if [ -z "$AI_MSG" ]; then
        echo "⚠️ AI generation failed. Retrying..." > /dev/tty
        continue
    fi

    # ----------------------------
    # 🧠 Show suggestion
    # ----------------------------
    echo > /dev/tty
    echo "==============================" > /dev/tty
    echo "🧠 AI Suggested Commit:" > /dev/tty
    echo "==============================" > /dev/tty
    echo "$AI_MSG" > /dev/tty
    echo "==============================" > /dev/tty

    # ----------------------------
    # 🎮 Menu
    # ----------------------------
    printf "[A]ccept, [E]dit, [M]anual, [S]how, [R]egenerate ? " > /dev/tty

    if ! IFS= read -r choice < /dev/tty; then
        choice="a"
    fi

    choice=$(printf '%s' "$choice" | tr '[:upper:]' '[:lower:]')

    case "$choice" in

        a|"")
            printf "%s\n" "$AI_MSG" > "$COMMIT_MSG_FILE"
            echo "✅ AI commit accepted" > /dev/tty
            exit 0
            ;;

        e)
            printf "%s\n" "$AI_MSG" > "$COMMIT_MSG_FILE"
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
            exit 0
            ;;

        m)
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
            exit 0
            ;;

        s)
            git diff --cached | less < /dev/tty > /dev/tty 2>&1
            ;;

        r)
            echo "🔄 regenerating AI commit..." > /dev/tty
            continue   # 🔥 correct way to restart loop
            ;;

        *)
            echo "Please choose A, E, M, S or R." > /dev/tty
            ;;
    esac

done

exit 0