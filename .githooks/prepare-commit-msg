#!/bin/bash

set -e

COMMIT_MSG_FILE="$1"
SOURCE="$2"

case "$SOURCE" in
    merge|squash)
        exit 0
        ;;
esac

if [ -s "$COMMIT_MSG_FILE" ]; then
    exit 0
fi

if [ ! -e /dev/tty ]; then
    exit 0
fi

DIFF=$(git diff --cached)

[ -z "$DIFF" ] && exit 0

echo > /dev/tty
echo "🤖 Git AI Assistant" > /dev/tty
echo "--------------------" > /dev/tty
echo "Generating suggestion..." > /dev/tty

if ! ollama --version >/dev/null 2>&1; then
    echo "⚠️ Ollama not found." > /dev/tty
    exit 0
fi

# ----------------------------
# ⏱ START TIMER
# ----------------------------
start_ns=$(date +%s%N)

DIFF_B64=$(git diff --cached | base64 | tr -d '\n')

AI_MSG=$(ollama run qwen2.5-coder:7b "
You are a git commit message generator.

The following is a BASE64 encoded git diff.

Decode it mentally and generate a single-line conventional commit message.

BASE64 DIFF:
$DIFF_B64

STRICT RULES:
- Output MUST follow Conventional Commits format
- Format: type(scope): short description
- NO full sentences
- NO period at the end
- MAX 80 characters
- Use imperative mood (e.g. add, fix, remove, update)
- Only ONE line output
- No explanation

Examples:
feat(auth): add login validation
fix(api): handle null response crash
chore(githooks): update commit hook logic
")

# ----------------------------
# ⏱ END TIMER
# ----------------------------
end_ns=$(date +%s%N)

# time in seconds
duration_ms=$(( (end_ns - start_ns) / 1000000 ))

# ----------------------------
# 🧠 TOKEN ESTIMATE
# ----------------------------
chars=$(printf "%s" "$DIFF_B64" | wc -c)
tokens=$((chars / 4))   # rough estimate: 1 token ≈ 4 chars

if [ "$duration_ms" -gt 0 ]; then
    tps=$(awk "BEGIN {printf \"%.2f\", $tokens / ($duration_ms / 1000)}")
else
    tps="∞"
fi

if [ -z "$AI_MSG" ]; then
    echo "⚠️ Failed to generate commit message." > /dev/tty
    exit 0
fi

# ----------------------------
# 📊 TPS OUTPUT
# ----------------------------
echo "⚡ Tokens/sec: $tps" > /dev/tty
echo "⏱ Time: ${duration_ms}ms" > /dev/tty
echo "🧮 Tokens (est): $tokens" > /dev/tty

echo > /dev/tty

prompt_choice() {
    local answer

    while true; do
        printf "[A]ccept, [E]dit, [M]anual, [S]how Changes ? " > /dev/tty

        if ! IFS= read -r answer < /dev/tty; then
            echo "a"
            return
        fi

        answer=$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')

        case "$answer" in
            a|e|m|s|"")
                echo "${answer:-a}"
                return
                ;;
        esac

        echo "Please choose A, E, M or S." > /dev/tty
    done
}

while true; do
    echo > /dev/tty
    echo "==============================" > /dev/tty
    echo "🧠 AI Suggested Commit:" > /dev/tty
    echo "==============================" > /dev/tty
    echo "$AI_MSG" > /dev/tty
    echo "==============================" > /dev/tty

    choice=$(prompt_choice)

    case "$choice" in

        a)
            printf "%s\n" "$AI_MSG" > "$COMMIT_MSG_FILE"
            echo "✅ AI commit accepted" > /dev/tty
            break
            ;;

        e)
            printf "%s\n" "$AI_MSG" > "$COMMIT_MSG_FILE"
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
            break
            ;;

        m)
            "${EDITOR:-nano}" "$COMMIT_MSG_FILE" < /dev/tty > /dev/tty 2>&1
            break
            ;;

        s)
            git diff --cached
            ;;
    esac
done

exit 0